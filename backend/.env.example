# Copy to backend/.env and adjust. Every value is optional in development.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string          # REQUIRED in production (python -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_TOKEN_MINUTES=480

# Database - SQLite for development, PostgreSQL for cloud
# DATABASE_URL=postgresql://safemetric:password@localhost:5432/safemetric
DATABASE_URL=

# Tesseract executable (pytesseract does NOT install it)
#   Linux/Docker: /usr/bin/tesseract
#   Windows:      C:\Program Files\Tesseract-OCR\tesseract.exe
#   macOS (brew): /opt/homebrew/bin/tesseract
TESSERACT_CMD=
OCR_LANG=eng
OCR_WORKERS=3

# Files
DATA_DIR=
UPLOAD_DIR=
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_INSPECTION=12

# Object storage: local | s3 | azure
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=            # e.g. https://<account>.r2.cloudflarestorage.com  or  https://<project>.supabase.co/storage/v1/s3
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=safemetric

# CORS - only needed when the frontend is served from a different origin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts
ALLOW_SELF_REGISTRATION=true
DEFAULT_ADMIN_EMAIL=admin@safemetric.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@12345                     # change immediately after first login
DEFAULT_ADMIN_NAME=System Administrator

# Rule 27 - optional authoritative registration API
REGISTRATION_API_URL=
REGISTRATION_API_KEY=
